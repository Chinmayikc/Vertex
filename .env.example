# Vertex College Technical Club - Environment Configuration Example
# Copy this file to .env for local development and set actual values in your Vercel Project Settings.
# NEVER commit .env with real credentials.

# ==============================================================================
# Supabase Configuration
# ==============================================================================

# Project reference identifier (e.g. "abcdefghijklmno")
SUPABASE_PROJECT_ID=""

# Supabase API URL (e.g. "https://your-project-id.supabase.co")
SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase Anon / Publishable Key (safe for public/browser access)
SUPABASE_PUBLISHABLE_KEY=""

# Supabase Service Role Key (SERVER-ONLY: administrative access, bypasses RLS)
# WARNING: NEVER expose this key to browser client code or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# Client-side (Vite) Supabase Variables
# Required for client-side authentication and real-time features.
# ==============================================================================

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
